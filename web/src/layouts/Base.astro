---
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "@fontsource/geist-mono/600.css";
import "../styles/fonts.css";
import "../styles/global.css";
import Mark from "../components/Mark.astro";
import { CARD_HEIGHT, CARD_WIDTH } from "../og/layout.mjs";
import bricolageUrl from "../fonts/BricolageGrotesque-VF-latin.woff2?url";
import gambettaUrl from "../fonts/Gambetta-400.woff2?url";
import geistMonoUrl from "@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url";

interface Props {
    title: string;
    description: string;
    ogImage?: string;
}

const { title, description, ogImage = "/og/default.png" } = Astro.props;
const site = Astro.site ?? new URL("https://pith-lang.org");
const ogUrl = new URL(ogImage, site);
const source = "https://codeberg.org/pith/pith";
const license = `${source}/src/branch/master/LICENSE`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="pith" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogUrl} />
        <meta property="og:image:width" content={String(CARD_WIDTH)} />
        <meta property="og:image:height" content={String(CARD_HEIGHT)} />
        <meta
            property="og:image:alt"
            content="An OG card in the pith identity."
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogUrl} />
        <meta name="color-scheme" content="light dark" />
        <meta
            name="theme-color"
            content="#f0ead8"
            media="(prefers-color-scheme: light)"
        />
        <meta
            name="theme-color"
            content="#1a1c17"
            media="(prefers-color-scheme: dark)"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="preload"
            href={bricolageUrl}
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href={gambettaUrl}
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href={geistMonoUrl}
            as="font"
            type="font/woff2"
            crossorigin
        />
    </head>
    <body>
        <header class="site-header">
            <div class="container header-row">
                <a class="wordmark display" href="/">
                    <Mark class="mark" />
                    <span>pith<span class="dot">.</span></span>
                </a>
                <nav class="site-nav label" aria-label="site">
                    <a href={source}>source</a>
                    <a href={license}>license</a>
                </nav>
            </div>
        </header>

        <main class="container">
            <slot />
        </main>

        <footer class="site-footer">
            <div class="container footer-row">
                <div class="f-brand">
                    <Mark class="mark" />
                    <span class="label">a kernel, grown</span>
                </div>
                <p class="label f-links">
                    © 2026 karol broda · <a href={license}>apache-2.0</a> · <a
                        href={source}>codeberg</a
                    >
                </p>
            </div>
        </footer>
    </body>
</html>
