---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const petal = 'M50,9 C56,19 56,29 50,39 C44,29 44,19 50,9 Z';
---

<svg viewBox="0 0 100 100" class={className} role="img" aria-hidden="true">
  <g fill="currentColor">
    <path d={petal}></path>
    <path d={petal} transform="rotate(72 50 50)"></path>
    <path d={petal} transform="rotate(144 50 50)"></path>
    <path d={petal} transform="rotate(216 50 50)" fill="var(--accent)"></path>
    <path d={petal} transform="rotate(288 50 50)"></path>
  </g>
  <circle cx="50" cy="50" r="4.2" fill="var(--pith)"></circle>
</svg>
