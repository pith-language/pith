---
interface Row {
  label: string;
  planned: number;
  note?: string;
}

const rows: Row[] = [
  { label: 'cold build', planned: 5 },
  { label: 'one source edited', planned: 3 },
  { label: 'nothing changed', planned: 0, note: 'reused' },
  { label: 'new process, same store', planned: 0, note: 'hydrated' },
];
---

<figure class="ledger box">
  <figcaption class="label">action computations planned</figcaption>
  <ul>
    {
      rows.map(({ label, planned, note }) => (
        <li class={note ? 'good' : ''}>
          <span class="row-label">{label}</span>
          <span class="leader" aria-hidden="true" />
          {note && <span class="note label">{note}</span>}
          <span class="num">{planned}</span>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .ledger {
    padding: 30px 34px 20px;
    max-width: 640px;
  }

  .ledger :global(.label) {
    color: var(--card-sub);
    letter-spacing: 0.18em;
  }

  ul {
    margin-top: 18px;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--card-line);
  }

  li:last-child {
    border-bottom: none;
  }

  .row-label {
    font-size: 19px;
    line-height: 1.3;
    white-space: nowrap;
  }

  .leader {
    flex: 1;
    border-bottom: 1px dotted var(--card-line);
    transform: translateY(-4px);
    min-width: 24px;
  }

  .num {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1;
    min-width: 1.2ch;
    text-align: right;
  }

  li.good .num,
  li.good :global(.label) {
    color: var(--card-pith);
  }

  @media (max-width: 560px) {
    .ledger {
      padding: 22px 16px 10px;
    }

    li {
      gap: 12px;
    }

    .row-label {
      white-space: normal;
      font-size: 17px;
    }

    .num {
      font-size: 34px;
    }

    .ledger :global(.label),
    .note {
      letter-spacing: 0.12em;
    }
  }
</style>
